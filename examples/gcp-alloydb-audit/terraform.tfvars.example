# =====================================================================
# GCP CONFIGURATION - CRITICAL
# =====================================================================
# REQUIRED: Your GCP project ID - MUST match where your AlloyDB cluster is deployed
gcp_project_id = "project-id"  # CHANGE THIS to your actual GCP project ID

# The GCP region where your AlloyDB cluster is deployed
gcp_region = "us-central1"  # CHANGE THIS to your actual region (e.g., "us-east1")

# The identifier of your AlloyDB cluster (found in AlloyDB console)
alloydb_cluster_id = "alloydb-cluster"

# The Pub/Sub topic ID to create for AlloyDB audit logs
pubsub_topic_id = "alloydb-topic-name"

# The Pub/Sub subscription ID to create for AlloyDB audit logs
pubsub_subscription_id = "alloydb-subscription-name"

# Whether this module should create the Pub/Sub topic, subscription, and Cloud Logging sink
# - true: create and manage those resources in this module
# - false: use existing Pub/Sub topic/subscription IDs that you provide above
enable_audit_logging = true

# Optional: override the sink name; leave empty to use <alloydb_cluster_id>-audit-sink
audit_log_sink_name = ""

# Ack deadline for the created Pub/Sub subscription
pubsub_ack_deadline = 60

# =====================================================================
# GUARDIUM CONFIGURATION - CRITICAL
# =====================================================================
# Name for the Universal Connector (used for GCP resource naming)
udc_name = "alloydb-audit-connector"

# REQUIRED: Name of the GCP credential defined in Guardium
# This must match a credential you've already created in Guardium
udc_gcp_credential = "gcp"

# REQUIRED: Guardium server hostname/IP and connection details
gdp_server = "guardium-cm-example.com"
gdp_port = "8443"
gdp_username = "admin"                 # Replace with your Guardium username
gdp_password = "password"              # Replace with your Guardium password

# REQUIRED: OAuth client credentials for Guardium API access
# These are obtained by running the "grdapi register_oauth_client" command
gdp_client_id = "your-client-id"              # Replace with your client ID
gdp_client_secret = "your-client-secret"    # Replace with your client secret

# Comma-separated list of Guardium Managed Units to deploy the profile to
gdp_mu_host = "guardium-mu-example.com"

# =====================================================================
# UNIVERSAL CONNECTOR CONFIGURATION
# =====================================================================
# Whether to enable the Universal Connector (set to false to disable)
enable_universal_connector = true

# Start position for log processing: "beginning" or "end"
# - "beginning": Process all available logs (may cause high initial load)
# - "end": Process only new logs going forward (recommended for production)
csv_start_position = "end"

# =====================================================================
# PUB/SUB CONFIGURATION
# =====================================================================
# Maximum number of messages to pull from Pub/Sub in a single request
# Higher values improve throughput but increase memory usage
max_messages = 100
