# AWS Configuration
aws_region = "us-east-1"
documentdb_cluster_identifier = "my-docdb-cluster"

# Guardium Configuration
gdp_server = "guardium.example.com"
gdp_port = "8443"  # Default port is 8443
gdp_username = "guardium-user"
gdp_password = "guardium-password"
gdp_ssh_username = "guardium-ssh-user"
gdp_ssh_privatekeypath = "/path/to/private/key"
gdp_client_id = "client1"
gdp_client_secret = "client-secret-value"
udc_aws_credential = "aws-credential-name"
gdp_mu_host = "mu1,mu2"  # Comma-separated list of Managed Units

# Universal Connector Configuration
udc_name = "documentdb-gdp"  # Default name for the connector
csv_interval = "30"  # Polling interval in seconds

# Log Directory Configuration
#----------------------------------------
# Directory on Guardium server where CSV files will be stored
# Leave empty to use default: /var/IBM/Guardium/file-server/upload
# This directory is accessible to both Guardium API and internal processes
# Common options:
#   - "" (empty) - Uses /var/IBM/Guardium/file-server/upload (default, API-accessible)
#   - "/var/IBM/Guardium/file-server/upload" - Explicit default (recommended)
#   - Custom path - Must be accessible to tomcat user for Guardium API
#----------------------------------------
log_directory = ""  # Leave empty for default /var/IBM/Guardium/file-server/upload

# Resource Tags
tags = {
  Environment = "Production"
  Owner       = "Security Team"
  Project     = "Guardium Integration"
}