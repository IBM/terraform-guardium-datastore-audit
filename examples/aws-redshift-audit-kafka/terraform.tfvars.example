# AWS Redshift Audit Kafka Configuration - Example Terraform Variables

##############################
# AWS Configuration
##############################
# AWS region where Redshift cluster is deployed
aws_region = "us-east-1"

# Prefix for resource names
name_prefix = "guardium"

# Identifier of the Redshift cluster
redshift_cluster_identifier = "my-redshift-cluster"

# Tags to apply to all resources
tags = {
  Purpose     = "guardium-redshift-kafka-uc"
  Owner       = "security-team@example.com"
  Environment = "production"
}

# Optional Log Group Configuration:
# Option 1: Base prefix (module automatically appends /connectionlog and /useractivitylog)
# existing_cloudwatch_log_group_name = "/aws/redshift/cluster/my-redshift-cluster"
#
# Option 2: Comma-separated list in existing_cloudwatch_log_group_name
# existing_cloudwatch_log_group_name = "/aws/redshift/cluster/my-redshift-cluster/connectionlog,/aws/redshift/cluster/my-redshift-cluster/useractivitylog"
#
# Option 3: Explicit list of log groups (overrides existing_cloudwatch_log_group_name)
# cloudwatch_log_groups = [
#   "/aws/redshift/cluster/my-redshift-cluster/connectionlog",
#   "/aws/redshift/cluster/my-redshift-cluster/useractivitylog"
# ]

##############################
# Guardium Data Protection Configuration
##############################
# Guardium Central Manager hostname or IP address
gdp_server = "guardium.example.com"

# Guardium Central Manager port (default: 8443)
gdp_port = 8443

# Guardium Web UI credentials
gdp_username = "guardium_admin"
gdp_password = "your-guardium-password"

# Guardium OAuth client credentials (from `grdapi register_oauth_client`)
gdp_client_id     = "your-client-id"
gdp_client_secret = "your-client-secret"

# Comma-separated list of Guardium Managed Units (e.g. "mu1.example.com,mu2.example.com")
gdp_mu_host = "managed-unit-1"

##############################
# Universal Connector Configuration
##############################
# Whether to enable the Universal Connector
enable_universal_connector = true

# Name of the AWS credential configured in Guardium Credential Management
udc_aws_credential = "my-aws-credential"

# Optional: Override the Universal Connector profile name
# udc_name = "aws-redshift-kafka-profile"

# Optional: Description for the Universal Connector profile
# udc_description = "GDP AWS Redshift Kafka connector"

##############################
# Kafka-specific Configuration
##############################
# Kafka cluster name configured in Guardium
kafka_cluster_name = "kafka"

# Whether to use ELB for the Kafka-based Universal Connector
use_elb = false

# CloudWatch Logs filter pattern to include or exclude log events
filter_pattern = "None"

# Redshift cluster name in AWS console (defaults to redshift_cluster_identifier)
# database_cluster_name = "my-redshift-cluster"

# Ingestion delay in minutes to allow CloudWatch to fully flush log events
event_delay = 15

# Number of minutes without incoming events before a no-traffic alert is raised
nodata_threshold_min = 60

# How frequently (in seconds) the connector polls CloudWatch for new log events (0-59)
poll_interval_sec = "30"

# How frequently (in minutes) the connector polls CloudWatch for new log events
poll_interval = 0

# Maximum number of log events fetched per CloudWatch API call
event_limit = 1000

# Initial polling time (ISO 8601). Leave empty to start from current time
# timestamp_start = "2026-01-01T00:00:00Z"

# When true, sensitive values (such as SQL query text) are unmasked in traffic data
unmask = false
