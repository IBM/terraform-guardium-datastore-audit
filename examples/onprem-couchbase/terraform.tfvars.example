# Couchbase Instance Configuration
couchbase_cluster_name   = "sysqa-uc-couchbase1"
couchbase_host           = "sysqa-uc-couchbase1.fyre.ibm.com"
couchbase_admin_port     = "8091"
couchbase_admin_username = "Administrator"
couchbase_admin_password = "your-couchbase-admin-password"
couchbase_audit_log_path = "/opt/couchbase/var/lib/couchbase/logs/*-audit.log"

# Server Connection Configuration (for SSH)
server_ip       = "sysqa-uc-couchbase1.fyre.ibm.com"
server_username = "root"
server_password = "M454b4ch@Gu@rd1um"

# Guardium Configuration
gdp_server        = "jessica-truck-cm-0531.dev.fyre.ibm.com"
gdp_port          = "8443"
gdp_username      = "admin"
gdp_password      = "M454b4ch@"
gdp_client_id     = "client4"
gdp_client_secret = "9f8d8004-3a26-4183-bd51-2a89ad029505"
gdp_mu_host       = "jessica-truck-m1-0531.dev.fyre.ibm.com"

# Universal Connector Configuration
udc_name                   = "couchbase-sysqa-filebeat"
enable_universal_connector = true

# Filebeat/Logstash Configuration
logstash_port                      = "5002"
ssl_enable                         = false
ssl_verify                         = false
ssl_cert_path                      = ""
ssl_certificate_authority_filename = ""

# Audit Configuration
enable_audit_log = true
enable_filebeat  = true

# CSV Configuration
csv_description = "Guardium connector for production Couchbase cluster"

# Tags
tags = {
  Environment = "production"
  Application = "couchbase-audit"
  ManagedBy   = "terraform"
}