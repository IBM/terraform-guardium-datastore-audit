###############################################################################
# Azure MySQL Audit Configuration - Example Terraform Variables
###############################################################################

#------------------------------------------------------------------------------
# Azure Configuration
#------------------------------------------------------------------------------

# Azure region where resources are deployed
azure_region = "eastus"

# Name of the Azure resource group containing the MySQL server
resource_group_name = "my-resource-group"

# Name of the Azure MySQL Flexible Server to be monitored
mysql_server_name = "my-mysql-server"

#------------------------------------------------------------------------------
# Event Hub Configuration
#------------------------------------------------------------------------------

# Name of the Event Hub namespace for audit log streaming
eventhub_namespace_name = "my-eventhub-namespace"

# Name of the Event Hub for audit log streaming
eventhub_name = "mysql-audit-logs"

# Name of the Event Hub namespace authorization rule
# Used for Azure diagnostic settings
# Default: "RootManageSharedAccessKey"
eventhub_authorization_rule_name = "RootManageSharedAccessKey"

# Name of the Event Hub shared access policy
# Used to build the UC connection string from the Event Hub primary key
eventhub_sas_policy_name = "mysql-eh-auth-rule"

# Name of the storage account for Event Hub checkpointing
storage_account_name = "mystorageaccount"

# Event Hub consumer group name
# Default: "$Default"
consumer_group = "$Default"

#------------------------------------------------------------------------------
# MySQL Firewall Configuration
#------------------------------------------------------------------------------

# Optional firewall rules to allow client IPs to connect to MySQL
# Get your public IP with: curl ifconfig.me
firewall_rules = {
  "my-local-ip" = {
    start_ip = "YOUR.PUBLIC.IP.HERE"  # Replace with your actual public IP
    end_ip   = "YOUR.PUBLIC.IP.HERE"  # Same as start_ip for single IP
  }
  # Add more rules as needed:
  # "office" = {
  #   start_ip = "203.0.113.0"
  #   end_ip   = "203.0.113.255"
  # }
}

#------------------------------------------------------------------------------
# Diagnostic Settings Configuration
#------------------------------------------------------------------------------

# Name of the diagnostic setting
diagnostic_setting_name = "mysql-audit-to-eventhub"

# Enable MySQL Audit logs
enable_mysql_audit_logs = true

#------------------------------------------------------------------------------
# Guardium Configuration
#------------------------------------------------------------------------------

# Hostname/IP address of Guardium Central Manager
gdp_server = "guardium.example.com"

# Port of Guardium Central Manager
gdp_port = "8443"

# Username of Guardium Web UI user
gdp_username = "admin"

# Password of Guardium Web UI user
gdp_password = "your-password-here"

# Client ID used when running grdapi register_oauth_client
gdp_client_id = "client1"

# Client secret from output of grdapi register_oauth_client
gdp_client_secret = "your-client-secret-here"

# Comma separated list of Guardium Managed Units to deploy profile
gdp_mu_host = "guardium-mu.example.com"

#------------------------------------------------------------------------------
# Universal Connector Configuration
#------------------------------------------------------------------------------

# Whether to enable the universal connector module
# Set to false to completely disable the universal connector for a run
enable_universal_connector = true

# Initial position for Event Hub consumer (beginning or end)
initial_position = "end"

#------------------------------------------------------------------------------
# Event Hub Advanced Configuration
#------------------------------------------------------------------------------

# Configuration mode for Event Hub input (basic or advanced)
config_mode = "basic"

# Number of threads for Event Hub consumer
threads = 8

# Whether to decorate events with Event Hub metadata
decorate_events = true
