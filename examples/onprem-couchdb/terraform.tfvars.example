##############################
# CouchDB Instance Configuration
##############################

# Unique identifier for your CouchDB instance
couchdb_instance_identifier = "prod-couchdb-01"

# Hostname or IP address of your CouchDB server
couchdb_host = "192.168.1.100"

# Path to CouchDB audit log file
# Default: "/var/log/couchdb/audit.log"
couchdb_audit_log_path = "/var/log/couchdb/*.log"

# Datasource tag for identifying the CouchDB instance in Guardium (REQUIRED)
# This tag helps identify and group audit logs from this CouchDB instance
datasource_tag = "prod-couchdb-cluster"

##############################
# Filebeat Configuration
##############################

# Enable Filebeat configuration on CouchDB server
# Set to true to configure Filebeat via SSH
# Set to false to skip Filebeat setup (only configure Guardium connector)
enable_filebeat_setup = true

# Server IP address or hostname for SSH connection
# REQUIRED when enable_filebeat_setup = true
server_ip = "192.168.1.100"

# Username for SSH connection to CouchDB server
# REQUIRED when enable_filebeat_setup = true
server_username = "couchdb"

# Password for SSH connection
# REQUIRED when enable_filebeat_setup = true
# IMPORTANT: Use environment variables or secure secret management for production
# Example: export TF_VAR_server_password="your-secure-password"
server_password = "your-secure-password"

##############################
# Guardium Configuration
##############################

# Guardium Central Manager hostname or IP address
gdp_server = "guardium.example.com"

# Guardium Central Manager port (default: 8443)
gdp_port = "8443"

# Guardium Web UI username
gdp_username = "admin"

# Guardium Web UI password
# IMPORTANT: Use environment variables or secure secret management for production
# Example: export TF_VAR_gdp_password="your-secure-password"
gdp_password = "your-secure-password"

# OAuth client ID from Guardium
# Obtain this by running: grdapi register_oauth_client
gdp_client_id = "your-client-id"

# OAuth client secret from Guardium
# IMPORTANT: Use environment variables or secure secret management for production
# Example: export TF_VAR_gdp_client_secret="your-client-secret"
gdp_client_secret = "your-client-secret"

# Comma-separated list of Guardium Managed Units to deploy the profile
# Leave empty to deploy to all managed units
gdp_mu_host = "guardium-mu-01"

##############################
# Universal Connector Configuration
##############################

# Name for the Universal Connector
# If not provided, will be auto-generated as: onprem-couchdb-<instance_identifier>
udc_name = "couchdb-prod-filebeat"

# Enable or disable the Universal Connector
# Set to false to skip connector creation
enable_universal_connector = true

# Description for the UDC connector
csv_description = "Guardium connector for production CouchDB instance"

##############################
# Logstash Configuration
##############################

# Port number for Logstash to listen for Filebeat messages from CouchDB (REQUIRED)
# This port is used in both Filebeat configuration and Guardium UDC template
# Default: 5044 (standard Filebeat port)
logstash_port = "5044"

##############################
# Tags
##############################

# Tags to apply to resources
# Useful for organisation, cost tracking, and automation
tags = {
  Environment = "production"
  Application = "couchdb-audit"
  ManagedBy   = "terraform"
  Owner       = "database-team"
}
